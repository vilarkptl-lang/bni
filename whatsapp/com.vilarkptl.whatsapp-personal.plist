<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vilarkptl.whatsapp-personal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
    <string>--user-data-dir=/Users/USUARIO/ChromeWhatsApp-personal</string>
    <string>--remote-debugging-port=9222</string>
    <string>--remote-debugging-address=127.0.0.1</string>
    <string>--no-first-run</string>
    <string>https://web.whatsapp.com</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
