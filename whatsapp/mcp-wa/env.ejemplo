# Variables de mcp-wa. Copiar a un archivo local NO versionado y llenar ahi.
# No poner aqui valores reales.

# Servidor MCP (escucha solo en localhost)
MCP_PUERTO=8765
# Nombre publico que el tunel existente manda en la cabecera Host (vacio = solo local)
MCP_HOST_PUBLICO=

# Puertos de depuracion de los Chrome ya abiertos (solo localhost)
MCP_PUERTO_CUENTA_A=9222
MCP_PUERTO_CUENTA_B=9223

# Marcas que aparecen en el DOM de la cuenta_a, separadas por |. Dejar vacio aqui.
MCP_MARCAS_CUENTA_A=

# Archivos y directorios locales
MCP_SELECTORES=./selectores.json
MCP_DIR_DESCARGAS=./descargas
MCP_DIR_BORRADORES=./borradores

# Plazos
MCP_PLAZO_HERRAMIENTA=45
MCP_PLAZO_ACCION_MS=8000
MCP_ESPERA_CARGA_MS=1500
